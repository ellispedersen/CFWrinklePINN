# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment
.venv/
.venv*/
venv/
env/

# Generated reports (large JSON)
reports/*.json

# HDF5 dataset (large binary)
data/dataset.h5
data/*.h5

# IDE
.vscode/settings.json
.idea/

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Ruff / linting cache
.ruff_cache/

# Training outputs
checkpoints/
latest.pt
best.pt
history.json
summary.json
*.log
*.out
*.err

# Test cache
.pytest_cache/

# ROCm / torch.compile debug artifacts (generated by TORCH_COMPILE_DEBUG=1)
torch_compile_debug/

# AniForm export artifacts
Test Export*.txt

# Old / broken venvs
.venv_broken*/

# Harness runner step directories (created by wsl_progressive_suite.sh)
\[step*\]*/

# Stray Unicode PUA filenames (icon font artifacts from terminal copy-paste)
$'\357'*
